{
  "expo": {
    "name": "Questlist",
    "slug": "questlist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "questlist",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.willianvaler.questlist",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F3D32",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.willianvaler.questlist",
      "permissions": [
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0F3D32",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#0F3D32",
          "defaultChannel": "default"
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app usa suas fotos para anexar às tarefas.",
          "cameraPermission": "O app usa a câmera para anexar fotos às tarefas.",
          "microphonePermission": "O app usa o microfone só quando você toca em Falar a lista, para ditar tarefas."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O app usa o microfone só quando você toca em Falar a lista, para ditar tarefas.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "./plugins/with-trusted-roots",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O app usa o microfone só quando você toca em Falar a lista, para ditar tarefas.",
          "speechRecognitionPermission": "O app transforma o que você fala em tarefas.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Tarefas, projetos com a galera e gamificação leve."
  }
}
