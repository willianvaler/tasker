<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- O Questlist aparece no "Compartilhar" de outros apps para texto e links (PB8, D303) e, desde o
       CP1 (D366), para uma imagem ou um PDF, que viram anexo da tarefa. O filtro entra na atividade
       principal do app pelo merge do manifest (mesmo nome, só acrescenta) -->
  <application>
    <activity android:name="com.willianvaler.questlist.MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="image/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="application/pdf" />
      </intent-filter>
    </activity>
  </application>
</manifest>
