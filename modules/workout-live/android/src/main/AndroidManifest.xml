<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Serviço em primeiro plano só enquanto o Modo Treino está aberto (D284): mantém o app vivo com
       o celular travado, para os botões da notificação funcionarem e as séries subirem na hora.
       O tipo "health" é o dos apps de exercício; a condição dele, sem pedir permissão na tela, é
       declarar HIGH_SAMPLING_RATE_SENSORS (permissão normal, concedida na instalação) -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
  <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
  <!-- Android 16: atualizações ao vivo (notificação promovida, com o chip na barra de status) -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <!-- CPU acordada no descanso e logo depois de um toque (Android Go dorme mesmo com o serviço) -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Aviso do timer na hora com a tela desligada (o expo-notifications usa se for concedido;
       no Android 14+ a pessoa liga em "Alarmes e lembretes") -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

  <application>
    <service
      android:name=".WorkoutLiveService"
      android:exported="false"
      android:foregroundServiceType="health" />
    <receiver
      android:name=".WorkoutActionReceiver"
      android:exported="false" />
    <!-- Toques no relógio (D287, wear/): Feita, Pular descanso e +30 s chegam por mensagem -->
    <service
      android:name=".WearActionService"
      android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
        <data android:scheme="wear" android:host="*" android:pathPrefix="/questlist/action" />
      </intent-filter>
    </service>
  </application>
</manifest>
